(module
  ;; the keyword-table fixture of vendor/pierre-highlights/test/wasm_test.ts
  (import "../../../vendor/pierre-highlights/src/common.wat")
  (keyword-table $Test $mem.laterWordsFree $mem.languageNames
    (group 2 "ab")
    (group 3 "abc")
    (group 4 "abcd")
    (group 5 "abcde")
    (group 6 "abcdef")
    (group 7 "abcdefg")
    (group 8 "abcdefgh")
    (group 9 "abcdefghi")
    (group 10 "abcdefghij")
    (group 11 "abcdefghijk")
    (group 12 "abcdefghijkl")
    (group 13 "abcdefghijklm")
    (group 14 "abcdefghijklmn")
    (group 15 "abcdefghijklmno")
    (group 16 "abcdefghijklmnop")
    (group 17 "abcdefghijklmnopq")
    (group 18 "abcdefghijklmnopqr")
    (group 19 "abcdefghijklmnopqrs")
    (group 20 "abcdefghijklmnopqrst")
    (group 21 "abcdefghijklmnopqrstu")
    (group 22 "abcdefghijklmnopqrstuv")
    (group 23 "abcdefghijklmnopqrstuvw")
    (group 24 "abcdefghijklmnopqrstuvwx")
    (group 25 "abcdefghijklmnopqrstuvwxy")
    (group 26 "abcdefghijklmnopqrstuvwxyz")
    (group 27 "abcdefghijklmnopqrstuvwxyza")
    (group 28 "abcdefghijklmnopqrstuvwxyzab")
    (group 29 "abcdefghijklmnopqrstuvwxyzabc")
    (group 30 "abcdefghijklmnopqrstuvwxyzabcd")
    (group 31 "abcdefghijklmnopqrstuvwxyzabcde"))
  (func (export "lookup") (param $n i32) (result i32)
    (keyword-table.value $Test (i32.const $mem.input)
      (i32.add (i32.const $mem.input) (local.get $n))))
  (func (export "lower") (param $n i32) (result i32)
    (call $lexLowerCopy (i32.const $mem.input)
      (i32.add (i32.const $mem.input) (local.get $n))
      (i32.const $mem.lexLowerScratch)))
  (global (export "scratch") i32 (i32.const $mem.lexLowerScratch))
  (global (export "input") i32 (i32.const $mem.input)))
